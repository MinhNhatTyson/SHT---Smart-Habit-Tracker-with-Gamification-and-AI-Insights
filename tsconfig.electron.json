{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "rootDir": "src/main",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/main"],
  "exclude": ["node_modules"]
}
