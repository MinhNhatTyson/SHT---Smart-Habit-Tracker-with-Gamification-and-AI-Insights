{
  "name": "sht",
  "version": "1.0.0",
  "description": "SHT — Streak · Habit · Tracker. A gamified habit tracking desktop app.",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "compile:main": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:main && concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run compile:main && vite build && electron-builder",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:all": "npx ts-node prisma/seed.ts && npx ts-node prisma/seed_store.ts && npx ts-node prisma/seed_quests.ts"
  },
  "keywords": ["habit", "tracker", "gamification", "electron", "streak"],
  "author": "HabitQuest",
  "license": "MIT",
  "build": {
    "appId": "com.habitquest.sht",
    "productName": "SHT",
    "asar": true,
    "asarUnpack": [
      "node_modules/@prisma/engines/**",
      "node_modules/@prisma/client/**",
      "node_modules/prisma/**",
      "node_modules/@libsql/**",
      "node_modules/libsql/**",
      "prisma/**"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "prisma": "^5.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  }
}
