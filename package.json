{
  "name": "sht",
  "version": "1.0.0",
  "description": "SHT — Streak · Habit · Tracker. A gamified habit tracking desktop app.",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "compile:main": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:main && concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": ["habit", "tracker", "gamification", "electron", "streak"],
  "author": "HabitQuest",
  "license": "MIT",
  "build": {
    "appId": "com.habitquest.sht",
    "productName": "SHT",
    "copyright": "Copyright © 2026 HabitQuest",
    "directories": {
      "output": "dist-app",
      "buildResources": "resources"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "executableName": "SHT",
      "artifactName": "SHT-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHT — Habit Tracker",
      "license": "LICENSE.txt"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "SHT-${version}-mac.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "resources/icon.png",
      "category": "Utility",
      "artifactName": "SHT-${version}.${ext}"
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "prisma": "^5.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  }
}