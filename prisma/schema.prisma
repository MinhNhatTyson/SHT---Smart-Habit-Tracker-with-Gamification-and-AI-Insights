// HabitQuest — Prisma Schema
// Database: SQLite (local file, no server needed)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. USER — the person using the app
// ─────────────────────────────────────────────────────────────
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  avatar        String?  // emoji avatar (fallback)
  level         Int      @default(1)
  totalPoints   Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)

  // ── Profile fields (added migration 20260519) ──────────────
  fullName      String?  // display name shown on profile
  gender        String?  // optional self-identification
  bio           String?  // short personal description
  avatarUrl     String?  // Cloudinary URL — overrides emoji avatar

  createdAt     DateTime @default(now())

  // Relations
  habits         Habit[]
  habitLogs      HabitLog[]
  badges         UserBadge[]
  challenges     UserChallenge[]
  insights       AIInsight[]
  posts          SocialPost[]
  friends        Friend[]        @relation("UserFriends")
  friendOf       Friend[]        @relation("FriendOf")
  challenges_created Challenge[] @relation("ChallengeCreator")
}

// ─────────────────────────────────────────────────────────────
// 2. HABIT
// ─────────────────────────────────────────────────────────────
model Habit {
  id                Int      @id @default(autoincrement())
  userId            Int
  name              String
  description       String?
  category          String
  color             String   @default("#6366f1")
  icon              String   @default("⚡")
  frequency         String   @default("daily")
  targetDaysPerWeek Int      @default(7)
  reminderTime      String?
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs     HabitLog[]
  insights AIInsight[]
  posts    SocialPost[]
}

// ─────────────────────────────────────────────────────────────
// 3. HABITLOG
// ─────────────────────────────────────────────────────────────
model HabitLog {
  id              Int      @id @default(autoincrement())
  habitId         Int
  userId          Int
  completedAt     DateTime @default(now())
  note            String?
  moodRating      Int?
  durationMinutes Int?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// 4. BADGE
// ─────────────────────────────────────────────────────────────
model Badge {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  icon        String
  rarity      String
  pointValue  Int
  condition   String

  users UserBadge[]
  posts SocialPost[]
}

// ─────────────────────────────────────────────────────────────
// 5. USERBADGE
// ─────────────────────────────────────────────────────────────
model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// ─────────────────────────────────────────────────────────────
// 6. CHALLENGE
// ─────────────────────────────────────────────────────────────
model Challenge {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  habitCategory String?
  pointReward   Int      @default(100)
  createdBy     Int

  creator      User            @relation("ChallengeCreator", fields: [createdBy], references: [id])
  participants UserChallenge[]
}

// ─────────────────────────────────────────────────────────────
// 7. USERCHALLENGE
// ─────────────────────────────────────────────────────────────
model UserChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int
  challengeId Int
  joinedAt    DateTime  @default(now())
  completedAt DateTime?
  progress    Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
}

// ─────────────────────────────────────────────────────────────
// 8. AIINSIGHT
// ─────────────────────────────────────────────────────────────
model AIInsight {
  id          Int      @id @default(autoincrement())
  userId      Int
  habitId     Int?
  type        String
  content     String
  generatedAt DateTime @default(now())
  isRead      Boolean  @default(false)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// 9. FRIEND
// ─────────────────────────────────────────────────────────────
model Friend {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// ─────────────────────────────────────────────────────────────
// 10. SOCIALPOST
// ─────────────────────────────────────────────────────────────
model SocialPost {
  id         Int      @id @default(autoincrement())
  userId     Int
  content    String
  badgeId    Int?
  habitId    Int?
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge? @relation(fields: [badgeId], references: [id])
  habit Habit? @relation(fields: [habitId], references: [id])
}
