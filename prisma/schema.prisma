// prisma/schema.prisma — HabitQuest with Store, Inventory, Quests & Goals

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. USER
// ─────────────────────────────────────────────────────────────
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  avatar        String?
  level         Int      @default(1)
  totalPoints   Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  fullName      String?
  gender        String?
  bio           String?
  avatarUrl     String?
  stars         Int      @default(0)
  createdAt     DateTime @default(now())

  habitSlots         Int     @default(5)
  activeTheme        String  @default("default")
  activeHabitSound   String  @default("default")
  activeBadgeSound   String  @default("default")
  streakShieldActive Boolean @default(false)
  activeTitle        String?
  unlockedTitles     String  @default("[]")
  unlockedAvatars    String  @default("[]")

  habits             Habit[]
  habitLogs          HabitLog[]
  badges             UserBadge[]
  challenges         UserChallenge[]
  insights           AIInsight[]
  posts              SocialPost[]
  friends            Friend[]        @relation("UserFriends")
  friendOf           Friend[]        @relation("FriendOf")
  challenges_created Challenge[]     @relation("ChallengeCreator")
  purchases          UserPurchase[]
  userQuests         UserQuest[]
  goals              Goal[]
}

// ─────────────────────────────────────────────────────────────
// 2. HABIT
// ─────────────────────────────────────────────────────────────
model Habit {
  id                Int      @id @default(autoincrement())
  userId            Int
  name              String
  description       String?
  category          String
  color             String   @default("#6366f1")
  icon              String   @default("⚡")
  frequency         String   @default("daily")
  targetDaysPerWeek Int      @default(7)
  reminderTime      String?
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs     HabitLog[]
  insights AIInsight[]
  posts    SocialPost[]
}

// ─────────────────────────────────────────────────────────────
// 3. HABITLOG
// ─────────────────────────────────────────────────────────────
model HabitLog {
  id              Int      @id @default(autoincrement())
  habitId         Int
  userId          Int
  completedAt     DateTime @default(now())
  note            String?
  moodRating      Int?
  durationMinutes Int?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// 4. BADGE
// ─────────────────────────────────────────────────────────────
model Badge {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  icon        String
  rarity      String
  starReward  Int
  condition   String
  category    String @default("general")

  users UserBadge[]
  posts SocialPost[]
}

// ─────────────────────────────────────────────────────────────
// 5. USERBADGE
// ─────────────────────────────────────────────────────────────
model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// ─────────────────────────────────────────────────────────────
// 6. STOREITEM
// ─────────────────────────────────────────────────────────────
model StoreItem {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String
  category    String
  icon        String
  starCost    Int
  itemType    String
  payload     String  @default("{}")
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────
// 7. USERPURCHASE
// ─────────────────────────────────────────────────────────────
model UserPurchase {
  id          Int      @id @default(autoincrement())
  userId      Int
  itemKey     String
  purchasedAt DateTime @default(now())
  quantity    Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
}

// ─────────────────────────────────────────────────────────────
// 8. QUEST
// ─────────────────────────────────────────────────────────────
model Quest {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  title       String
  description String
  flavour     String  @default("")
  tier        String
  icon        String  @default("⚔️")
  starReward  Int     @default(10)
  condition   String
  target      Int     @default(1)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  userQuests UserQuest[]
}

// ─────────────────────────────────────────────────────────────
// 9. USERQUEST
// ─────────────────────────────────────────────────────────────
model UserQuest {
  id         Int       @id @default(autoincrement())
  userId     Int
  questId    Int
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  progress   Int       @default(0)
  completed  Boolean   @default(false)
  claimed    Boolean   @default(false)
  claimedAt  DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// 10. GOAL
// ─────────────────────────────────────────────────────────────
model Goal {
  id           Int       @id @default(autoincrement())
  userId       Int
  title        String
  description  String?
  category     String
  targetType   String    @default("habit_count")
  targetValue  Int       @default(1)
  currentValue Int       @default(0)
  unit         String?
  deadline     DateTime?
  habitIds     String    @default("[]")
  status       String    @default("active")
  priority     String    @default("medium")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// 11. CHALLENGE
// ─────────────────────────────────────────────────────────────
model Challenge {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  habitCategory String?
  pointReward   Int      @default(100)
  createdBy     Int

  creator      User            @relation("ChallengeCreator", fields: [createdBy], references: [id])
  participants UserChallenge[]
}

// ─────────────────────────────────────────────────────────────
// 12. USERCHALLENGE
// ─────────────────────────────────────────────────────────────
model UserChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int
  challengeId Int
  joinedAt    DateTime  @default(now())
  completedAt DateTime?
  progress    Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
}

// ─────────────────────────────────────────────────────────────
// 13. AIINSIGHT
// ─────────────────────────────────────────────────────────────
model AIInsight {
  id          Int      @id @default(autoincrement())
  userId      Int
  habitId     Int?
  type        String
  content     String
  generatedAt DateTime @default(now())
  isRead      Boolean  @default(false)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// 14. FRIEND
// ─────────────────────────────────────────────────────────────
model Friend {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId],   references: [id], onDelete: Cascade)
  friend User @relation("FriendOf",    fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// ─────────────────────────────────────────────────────────────
// 15. SOCIALPOST
// ─────────────────────────────────────────────────────────────
model SocialPost {
  id         Int      @id @default(autoincrement())
  userId     Int
  content    String
  badgeId    Int?
  habitId    Int?
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge? @relation(fields: [badgeId], references: [id])
  habit Habit? @relation(fields: [habitId], references: [id])
}
