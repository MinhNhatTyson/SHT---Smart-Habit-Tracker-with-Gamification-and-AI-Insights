// HabitQuest — Prisma Schema
// Database: SQLite (local file, no server needed)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// 1. USER — the person using the app
// ─────────────────────────────────────────
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  avatar        String? // emoji or image path
  level         Int      @default(1)
  totalPoints   Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  createdAt     DateTime @default(now())

  // Relations
  habits             Habit[]
  habitLogs          HabitLog[]
  badges             UserBadge[]
  challenges         UserChallenge[]
  insights           AIInsight[]
  posts              SocialPost[]
  friends            Friend[]        @relation("UserFriends")
  friendOf           Friend[]        @relation("FriendOf")
  challenges_created Challenge[]     @relation("ChallengeCreator")
}

// ─────────────────────────────────────────
// 2. HABIT — a habit the user wants to build
// ─────────────────────────────────────────
model Habit {
  id                Int      @id @default(autoincrement())
  userId            Int
  name              String
  description       String?
  category          String // Health, Study, Finance, Mindfulness, etc.
  color             String   @default("#6366f1") // hex color for UI
  icon              String   @default("⚡") // emoji or icon name
  frequency         String   @default("daily") // daily | weekly | custom
  targetDaysPerWeek Int      @default(7)
  reminderTime      String? // "07:30" format
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())

  // Relations
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs     HabitLog[]
  insights AIInsight[]
  posts    SocialPost[]
}

// ─────────────────────────────────────────
// 3. HABITLOG — every completion event
// ─────────────────────────────────────────
model HabitLog {
  id              Int      @id @default(autoincrement())
  habitId         Int
  userId          Int
  completedAt     DateTime @default(now())
  note            String? // optional journal entry
  moodRating      Int? // 1–5 how user felt
  durationMinutes Int? // optional time tracking

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// 4. BADGE — all achievable badges
// ─────────────────────────────────────────
model Badge {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  icon        String // emoji or image path
  rarity      String // common | rare | epic | legendary
  pointValue  Int // XP rewarded on unlock
  condition   String // e.g. "streak_7", "logs_100", "level_5"

  // Relations
  users UserBadge[]
  posts SocialPost[]
}

// ─────────────────────────────────────────
// 5. USERBADGE — badges a user has earned
// ─────────────────────────────────────────
model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId]) // can't earn same badge twice
}

// ─────────────────────────────────────────
// 6. CHALLENGE — time-limited group challenges
// ─────────────────────────────────────────
model Challenge {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  habitCategory String?
  pointReward   Int      @default(100)
  createdBy     Int

  // Relations
  creator      User            @relation("ChallengeCreator", fields: [createdBy], references: [id])
  participants UserChallenge[]
}

// ─────────────────────────────────────────
// 7. USERCHALLENGE — user participation in challenges
// ─────────────────────────────────────────
model UserChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int
  challengeId Int
  joinedAt    DateTime  @default(now())
  completedAt DateTime?
  progress    Int       @default(0) // percentage 0-100

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId]) // can't join same challenge twice
}

// ─────────────────────────────────────────
// 8. AIINSIGHT — AI-generated messages & suggestions
// ─────────────────────────────────────────
model AIInsight {
  id          Int      @id @default(autoincrement())
  userId      Int
  habitId     Int? // related habit, if any
  type        String // pattern | suggestion | motivation
  content     String // the AI message text
  generatedAt DateTime @default(now())
  isRead      Boolean  @default(false)

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId], references: [id])
}

// ─────────────────────────────────────────
// 9. FRIEND — social connections between users
// ─────────────────────────────────────────
model Friend {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  status    String   @default("pending") // pending | accepted
  createdAt DateTime @default(now())

  // Relations
  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId]) // no duplicate connections
}

// ─────────────────────────────────────────
// 10. SOCIALPOST — achievements shared to feed
// ─────────────────────────────────────────
model SocialPost {
  id         Int      @id @default(autoincrement())
  userId     Int
  content    String
  badgeId    Int? // badge being shared
  habitId    Int? // habit milestone being shared
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge? @relation(fields: [badgeId], references: [id])
  habit Habit? @relation(fields: [habitId], references: [id])
}
